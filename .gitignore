# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# receipt-enrichment consolidated cache — vendor invoice PDFs, extraction caches, and LIVE
# Playwright sessions (TopRx, ULINE, Walmart auth cookies). ~360MB. NEVER commit.
# One rule replaces what used to be five scattered ones; the per-module rules below are kept so a
# missed call site regenerating a cache at an old path is still ignored.
scripts/receipt-enrichment/cache/

# ramp-split-push preview output (contains cardholder PII)
scripts/ramp-split-push/out/

# amazon-enrich preview/live output (contains cardholder PII)
scripts/amazon-enrich/out/

# walmart-enrich persisted login session (auth cookies — never commit)
scripts/walmart-enrich/.wm-session/

# receipt-capture state/output (auth sessions, screenshots, PII-bearing output)
scripts/receipt-capture/.state/
scripts/receipt-capture/.probe-shots/
scripts/receipt-capture/out/

.vercel
.env*
!.env.example

# SDD scratch (ledgers, briefs, review packages) — never committed
.superpowers/

# Probe/dry-run CSV dumps. These are exports of real Ramp + QuickBooks transactions and routinely
# carry a `cardholder` column — employee names tied to individual spending. Same reason
# scripts/ramp-split-push/out/ is ignored above; scripts/out/ was simply never covered.
# NOTE: CSVs already tracked here predate this rule and are unaffected (git only ignores
# untracked files) — see TODO.md for the follow-up to review and purge them.
scripts/out/*.csv

# Receipt-enrichment program env — Ramp secrets, Supabase service role key, RDS URL.
scripts/receipt-enrichment/.env
